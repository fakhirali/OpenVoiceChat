# Secrets only. Everything else is code configuration:
# openvoicechat/config.py, or main.py flags (--model, --base-url, --voice).

# LLM API key. Any non-empty value works for local OpenAI-compatible servers.
LLM_API_KEY=
# OPENAI_API_KEY=        # accepted as an alternative to LLM_API_KEY

# Optional: Daily agent server and scripts/daily_test.py
AGENT_API_TOKEN=
DAILY_API_KEY=
