# LLM: any OpenAI-compatible API. Empty LLM_BASE_URL means OpenAI.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-nano
LLM_TIMEOUT=15

# Local examples:
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama
# LLM_BASE_URL=http://localhost:8080/v1    # llama.cpp
# LLM_BASE_URL=http://localhost:8000/v1    # vLLM
# LLM_MODEL=qwen3:4b
# LLM_API_KEY=local

# Local models
LOCAL_TTS_VOICE=af_heart

# Turn taking
VAD_THRESHOLD=0.6
ENDPOINT_SILENCE_MS=600
PRE_ROLL_MS=300
MIN_SPEECH_MS=250
MAX_UTTERANCE_MS=30000
OUTPUT_CHUNK_MS=100

# Optional: Daily agent server
# generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=
DATA_DIR=data
MAX_SESSIONS=5
